# Local PostgreSQL (development only)
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# API database connection
DATABASE_URL=postgresql+psycopg://bookflow:change-this-local-password@localhost:5432/bookflow

# Authentication: generate independent secrets before any shared deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-different-long-random-secret
OTP_ENCRYPTION_KEY=generate-a-valid-fernet-key
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# TumaSend messaging (leave blank until the account and sender ID are approved)
TUMASEND_API_KEY=
TUMASEND_BASE_URL=https://gateway.tumasend.com
TUMASEND_SMS_SENDER_ID=
TUMASEND_WEBHOOK_SECRET=
