# Local PostgreSQL and Redis (development only)
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

# API database and distributed rate limiter
DATABASE_URL=postgresql+psycopg://bookflow:change-this-local-password@localhost:5432/bookflow
REDIS_URL=redis://localhost:6379/0

# Authentication: development placeholders only. Generate independent random secrets for deployments.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=bookflow-ai
JWT_AUDIENCE=bookflow-ai-api
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=720
OTP_PEPPER=replace-with-a-different-long-random-secret
OTP_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# TumaSend: separate asset-scoped keys; populate only after provider approval.
TUMASEND_WHATSAPP_API_KEY=
TUMASEND_SMS_API_KEY=
TUMASEND_BASE_URL=https://gateway.tumasend.com
TUMASEND_SMS_SENDER_ID=
TUMASEND_WEBHOOK_SECRET=
