# Local PostgreSQL (development only)
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# API database connection
DATABASE_URL=postgresql+psycopg://bookflow:change-this-local-password@localhost:5432/bookflow

# Authentication: generate strong random secrets before any shared deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-different-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_DELIVERY_PROVIDER=unconfigured
