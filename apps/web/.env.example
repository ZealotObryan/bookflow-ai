# Set this after the FastAPI service has a stable HTTPS URL.
# Example: https://api.bookflow.example
NEXT_PUBLIC_API_BASE_URL=

# Cloudflare Turnstile public site key for the customer booking page.
# The matching secret belongs in the API environment as CLOUDFLARE_TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
